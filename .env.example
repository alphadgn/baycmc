# Copy to .env for local development. Placeholders only — never commit real values.
# In Lovable Cloud these are provided by the Supabase integration / Project Secrets.

# Supabase (browser bundle, build time)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<supabase-publishable-key>
VITE_SUPABASE_PROJECT_ID=<project-ref>

# Supabase (server)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<supabase-publishable-key>
SUPABASE_PROJECT_ID=<project-ref>
# SUPABASE_SERVICE_ROLE_KEY=<server-only; set as a secret, never in the browser>

# Third-party APIs (server)
GIPHY_API_KEY=<giphy-api-key>
# LOVABLE_API_KEY=<ai-gateway-key>
# FIRECRAWL_API_KEY=<firecrawl-key>

# Deployment configuration (server) — see the health-report PR notes
# SITE_DOMAIN=baycmc.app            # comma-separated SIWE allowlist
# SECURITY_SCAN_SECRET=<random>     # bearer secret for /api/public/security-scan
# STREAM_LIFECYCLE_SECRET=<random>  # bearer secret for /api/public/stream-lifecycle
# LIVEKIT_URL=wss://<livekit-host>
# LIVEKIT_API_KEY=<livekit-key>
# LIVEKIT_API_SECRET=<livekit-secret>
